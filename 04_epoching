#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import mne
import os
import numpy as np
from pathlib import Path

# CONFIGURACIÓN
INPUT_DIR = Path("/home/marta.navarrobernad/Desktop/sub-P02/eeg/ESG_CLEAN_OBS")
EPOCHS_STAGE_DIR = Path("/home/marta.navarrobernad/Desktop/sub-P02/eeg/EPOCHS_STAGING")
EPOCHS_STAGE_DIR.mkdir(exist_ok=True, parents=True)

# --- ETIQUETADO JERÁRQUICO MAESTRO ---
EVENT_ID = {
    'Attentive/LS/GS': 10, 'Attentive/LS/GD': 11, 
    'Attentive/LD/GS': 12, 'Attentive/LD/GD': 13,
    'Inattentive/LS/GS': 20, 'Inattentive/LS/GD': 21, 
    'Inattentive/LD/GS': 22, 'Inattentive/LD/GD': 23
}

TRIGGER_MAP = {
    69:  'Attentive/LS/GS', 133: 'Attentive/LS/GS',
    149: 'Attentive/LS/GD', 85:  'Attentive/LS/GD',
    141: 'Attentive/LD/GS', 77:  'Attentive/LD/GS',
    157: 'Attentive/LD/GD', 93:  'Attentive/LD/GD',
    101: 'Inattentive/LS/GS', 165: 'Inattentive/LS/GS', 
    181: 'Inattentive/LS/GD', 117: 'Inattentive/LS/GD', 
    173: 'Inattentive/LD/GS', 109: 'Inattentive/LD/GS', 
    189: 'Inattentive/LD/GD', 125: 'Inattentive/LD/GD'
}

def main():
    files = sorted(list(INPUT_DIR.glob("*_OBS_Clean.fif")))
    
    if not files:
        print(f" No se encontraron archivos en {INPUT_DIR}")
        return

    for f_path in files:
        print(f"\n PROCESANDO: {f_path.name}")
        raw = mne.io.read_raw_fif(f_path, preload=True, verbose=False)
        
        events, ev_id = mne.events_from_annotations(raw, verbose=False)
        
        # 1. Mapeo inverso de anotaciones para saber qué número corresponde a qué valor interno
        # ev_id tiene {'Stimulus/S 69': 1, ...}
        val_to_trigger = {}
        for annot, val in ev_id.items():
            num_str = "".join(filter(str.isdigit, annot))
            if num_str:
                val_to_trigger[val] = int(num_str)

        # 2. CREACIÓN DE NUEVOS EVENTOS (Adjudicación de IDs del 10 al 23)
        # Filtramos habituación y transformamos IDs simultáneamente
        clean_events = []
        # Empezamos después de los 75 de habituación
        events_no_hab = events[75:] 

        for ev in events_no_hab:
            orig_val = ev[2]
            if orig_val in val_to_trigger:
                trigger_num = val_to_trigger[orig_val]
                if trigger_num in TRIGGER_MAP:
                    label = TRIGGER_MAP[trigger_num]
                    new_id = EVENT_ID[label]
                    # Guardamos el evento con el ID maestro (10-23)
                    clean_events.append([ev[0], 0, new_id])

        if not clean_events:
            print(f"  ERROR: No se generaron eventos válidos para este archivo.")
            continue

        new_events_array = np.array(clean_events)

        # 3. CREAR ÉPOCAS
        # Ahora usamos EVENT_ID (el maestro) y new_events_array (que ya tiene los 10, 11...)
        epochs = mne.Epochs(raw, new_events_array, event_id=EVENT_ID, 
                            tmin=-0.8, tmax=0.8, 
                            baseline=(-0.8, 0.0), 
                            preload=True, verbose=False,
                            on_missing='ignore') # Ignora si en un Run falta una condición
        
        # 4. Guardar
        out_name = f_path.stem + "-epo.fif"
        save_path = EPOCHS_STAGE_DIR / out_name
        epochs.save(save_path, overwrite=True, verbose=False)
        
        print(f" GUARDADO EXITOSO")
        print(f" ÉPOCAS GENERADAS: {len(epochs)}")

if __name__ == "__main__":
    main()
