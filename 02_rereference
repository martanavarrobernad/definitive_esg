"""
STEP 2: DOUBLE RE-REFERENCING (TH6 and AC)
- bipolar calculation for Erb and Axilla prior to global re-referencing.
"""

from pathlib import Path
import mne
import gc

# Configuration
SUBJECT_DIR = Path("/home/marta.navarrobernad/Desktop/sub-P02/eeg")

CHANNELS_OF_INTEREST = [
    'Iz', 'SC1', 'SC6', 'S3', 'S4', 'S5', 'S6', 'S7', 'S8', 'S9', 
    'S11', 'S12', 'S13', 'S14', 'S15', 'S16', 'S17', 'S18', 'S19',
    'ENG_AXILLA', 'ENG_AXILLA_REF', 'ENG_ERB', 'ENG_ERB_REF', 'AC', 'TH6'
]

REFERENCES = ['TH6', 'AC']

def main():
    run_files = sorted(list(SUBJECT_DIR.glob("*_NoStimArtifact.vhdr")))
    
    if not run_files:
        print(f" No files found with suffix '_NoStimArtifact.vhdr' in: {SUBJECT_DIR}")
        return

    print(f" Found {len(run_files)} files for re-referencing.")

    for f_path in run_files:
        print(f"\n--- Processing: {f_path.name} ---")
        
        for ref in REFERENCES:
            raw = mne.io.read_raw_brainvision(f_path, preload=True, verbose=False)
            
            # Ensure EEG channel types
            raw.set_channel_types({ch: 'eeg' for ch in raw.ch_names if ch in CHANNELS_OF_INTEREST})

            # For Erb and Axilla, we use their own reference channels to create a bipolar montage.
            # This prevents ERB and AXILLA from being contaminated by TH6 or AC global references.

            # Preparation for bipolar channels 
            # 1. Rename original channels to avoid naming conflicts
            mapping = {}
            if 'ENG_ERB' in raw.ch_names: mapping['ENG_ERB'] = 'ENG_ERB_RAW'
            if 'ENG_AXILLA' in raw.ch_names: mapping['ENG_AXILLA'] = 'ENG_AXILLA_RAW'
            
            if mapping:
                raw.rename_channels(mapping)

            # 2. Create bipolar montage using the desired FINAL channel names
            if 'ENG_ERB_RAW' in raw.ch_names and 'ENG_ERB_REF' in raw.ch_names:
                print("  -> Calculating Erb Bipolar...")
                mne.set_bipolar_reference(raw, anode=['ENG_ERB_RAW'], cathode=['ENG_ERB_REF'], 
                                          ch_name='ENG_ERB', drop_refs=False, copy=False)
            
            if 'ENG_AXILLA_RAW' in raw.ch_names and 'ENG_AXILLA_REF' in raw.ch_names:
                print("  -> Calculating Axilla Bipolar...")
                mne.set_bipolar_reference(raw, anode=['ENG_AXILLA_RAW'], cathode=['ENG_AXILLA_REF'], 
                                          ch_name='ENG_AXILLA', drop_refs=False, copy=False)

            # 3. Drop redundant channels to keep averages clean
            # Remove 'RAW' and 'REF' channels that are no longer needed
            ch_to_drop = ['ENG_ERB_RAW', 'ENG_ERB_REF', 'ENG_AXILLA_RAW', 'ENG_AXILLA_REF']
            raw.drop_channels([ch for ch in ch_to_drop if ch in raw.ch_names])

            # Force EEG type so they are not lost during saving/averaging
            new_types = {ch: 'eeg' for ch in ['ENG_ERB', 'ENG_AXILLA'] if ch in raw.ch_names}
            raw.set_channel_types(new_types)

            # Global re-referencing
            if ref in raw.ch_names:
                # 1. Define which channels SHOULD be re-referenced (spinal channels)
                # Explicitly exclude bipolar channels and the reference channel itself
                spinal_channels = [ch for ch in raw.ch_names if ch in CHANNELS_OF_INTEREST 
                                   and ch not in ['ENG_ERB', 'ENG_AXILLA', 'ENG_ERB_REF', 'ENG_AXILLA_REF', ref]]
                
                print(f"  -> Re-referencing {len(spinal_channels)} channels to {ref}...")
                
                # 2. Apply reference ONLY to those channels
                # In MNE, passing a list to ref_channels keeps the rest unchanged
                raw.set_eeg_reference(ref_channels=[ref], verbose=False)
                
                # Note: By default, MNE applies this to all 'eeg' types. 
                # To be 100% sure ERB/AXILLA are untouched, they could have remained as 'misc' 
                # until this step, changing type to 'eeg' JUST before saving.
                
                out_name = SUBJECT_DIR / f"{f_path.stem}_Ref{ref}.fif"
                raw.save(out_name, overwrite=True, verbose=False)
                print(f"  Saved: {out_name.name}")
            
            # Memory cleanup
            del raw
            gc.collect()

    print("\n Done")

if __name__ == "__main__":
    main()
