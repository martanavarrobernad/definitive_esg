import mne
import os
import glob
import matplotlib.pyplot as plt

# Configuración de triggers
TRIGGER_MAP = {
    'INATENTO': {
        'LOCAL':  {'S': [165, 181, 117, 101], 'D': [125, 109, 173, 189]},
        'GLOBAL': {'S': [165, 109, 173, 101], 'D': [125, 181, 117, 189]}
    },
    'ATENTO': {
        'LOCAL':  {'S': [85, 149, 133, 69],   'D': [141, 77, 93, 157]},
        'GLOBAL': {'S': [141, 77, 133, 69],   'D': [85, 149, 93, 157]}
    }
}

FILTROS = ["Nierula_Std", "Nierula_Late", "Gabrieli", "Nierula_Otro", "Mehra", "Wimmer", "Boehme"]
REFERENCIAS = ["AC", "TH6"]
INPUT_PATH = "/home/marta.navarrobernad/Desktop/sub-P02/eeg/CLEAN_EPOCHS_BENCHMARK"

def run_averaging_pipeline():
    for ref in REFERENCIAS:
        root_avg_dir = f"averages_{ref}"
        
        for filtro in FILTROS:
            for estado in ['INATENTO', 'ATENTO']:
                runs = range(1, 5) if estado == 'INATENTO' else range(5, 9)
                all_epochs_list = []
                
                for r in runs:
                    pattern = os.path.join(INPUT_PATH, f"*Run{r}*Ref{ref}*{filtro}*-epo.fif")
                    files = glob.glob(pattern)
                    
                    if files:
                        epochs = mne.read_epochs(files[0], preload=True)
                        # Reset de event_id para evitar conflictos de nombres
                        new_event_id = {str(val): val for val in epochs.events[:, 2]}
                        epochs.event_id = new_event_id
                        all_epochs_list.append(epochs)
                
                if not all_epochs_list:
                    continue
                
                combined_epochs = mne.concatenate_epochs(all_epochs_list)
                
                for tipo in ['LOCAL', 'GLOBAL']:
                    target_dir = os.path.join(root_avg_dir, estado, tipo)
                    os.makedirs(target_dir, exist_ok=True)
                    
                    ids_s = [str(i) for i in TRIGGER_MAP[estado][tipo]['S']]
                    ids_d = [str(i) for i in TRIGGER_MAP[estado][tipo]['D']]
                    
                    present_ids = combined_epochs.event_id.keys()
                    valid_s = [i for i in ids_s if i in present_ids]
                    valid_d = [i for i in ids_d if i in present_ids]
                    
                    evokeds_dict = {}
                    if valid_s:
                        ev_s = combined_epochs[valid_s].average()
                        ev_s.comment = 'Standard'
                        evokeds_dict['Standard'] = ev_s
                        
                    if valid_d:
                        ev_d = combined_epochs[valid_d].average()
                        ev_d.comment = 'Deviant'
                        evokeds_dict['Deviant'] = ev_d
                    
                    if evokeds_dict:
                        # 1. Guardar archivo .fif
                        output_filename = f"Avg_{filtro}_{ref}_{estado}_{tipo}"
                        output_path_fif = os.path.join(target_dir, f"{output_filename}-ave.fif")
                        mne.write_evokeds(output_path_fif, list(evokeds_dict.values()), overwrite=True)
                        
                        # 2. Generar y guardar gráfico comparativo (Butterfly plot + GFP)
                        try:
                            fig = mne.viz.plot_compare_evokeds(
                                evokeds_dict, 
                                picks='eeg', 
                                title=f"{filtro} {ref} {estado} {tipo}",
                                show=False
                            )
                            # plot_compare_evokeds devuelve una lista de figuras
                            if isinstance(fig, list):
                                fig = fig[0]
                            
                            output_path_png = os.path.join(target_dir, f"{output_filename}.png")
                            fig.savefig(output_path_png)
                            plt.close(fig) # Liberar memoria
                        except Exception as e:
                            print(f"No se pudo generar el gráfico para {output_filename}: {e}")

                        print(f"Procesado: {output_filename}")

if __name__ == "__main__":
    run_averaging_pipeline()
