#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import mne
import os
from pathlib import Path
import gc

# CONFIGURACION
CLEAN_DIR = Path("/home/marta.navarrobernad/Desktop/sub-P02/eeg/CLEAN_EPOCHS_BENCHMARK")
BASE_AVE = CLEAN_DIR / "AVERAGES"

FILTROS = ["Nierula_Std", "Nierula_Late", "Gabrieli", "Nierula_Otro", "Mehra", "Wimmer", "Boehme"]
REFS = ['AC', 'TH6']

TRIGGER_MAP = {
    'INATENTO': {
        'LOCAL':  {'S': [165, 181, 117, 101], 'D': [125, 109, 173, 189]},
        'GLOBAL': {'S': [165, 109, 173, 101], 'D': [125, 181, 117, 189]}
    },
    'ATENTO': {
        'LOCAL':  {'S': [85, 149, 133, 69],   'D': [141, 77, 93, 157]},
        'GLOBAL': {'S': [141, 77, 133, 69],   'D': [85, 149, 93, 157]}
    }
}

RUNS_CONFIG = {
    'INATENTO': ['run1', 'run2', 'run3', 'run4'],
    'ATENTO':   ['run5', 'run6', 'run7', 'run8']
}

def crear_averages_estrictos():
    print("Iniciando promediado con filtrado estricto de referencia...")
    
    # Pillamos todos los .fif que no sean promedios previos
    all_fifs = [f for f in CLEAN_DIR.glob("*.fif") if "GA_" not in f.name]
    print(f"Total archivos base detectados: {len(all_fifs)}")

    for task, runs_list in RUNS_CONFIG.items():
        for level in ['LOCAL', 'GLOBAL']:
            out_path = BASE_AVE / task / level
            out_path.mkdir(parents=True, exist_ok=True)
            
            ids_s_d = TRIGGER_MAP[task][level]['S'] + TRIGGER_MAP[task][level]['D']

            for ref in REFS:
                for f_name in FILTROS:
                    target_files = []
                    
                    # Definimos la referencia "enemiga" para excluirla
                    other_ref = 'TH6' if ref == 'AC' else 'AC'
                    
                    for f in all_fifs:
                        name_low = f.name.lower()
                        
                        # CONDICIONES ESTRICTAS
                        es_filtro = f_name.lower() in name_low
                        es_ref_correcta = f"ref{ref.lower()}" in name_low
                        no_es_ref_falsa = f"ref{other_ref.lower()}" not in name_low
                        es_run_tarea = any(r.lower() in name_low for r in runs_list)
                        
                        if es_filtro and es_ref_correcta and no_es_ref_falsa and es_run_tarea:
                            target_files.append(f)
                    
                    if not target_files:
                        continue

                    print(f"Procesando: {task} | {level} | {ref} | {f_name} ({len(target_files)} archivos)")
                    
                    epochs_list = []
                    for f in target_files:
                        try:
                            ep = mne.read_epochs(f, preload=True, verbose=False)
                            ep.event_id = {str(v): v for v in ep.event_id.values()}
                            
                            keys_validas = [k for k in ep.event_id.keys() if int(k) in ids_s_d]
                            if keys_validas:
                                epochs_list.append(ep[keys_validas])
                        except:
                            continue

                    if len(epochs_list) > 0:
                        combined = mne.concatenate_epochs(epochs_list)
                        evoked = combined.average()
                        
                        out_name = out_path / f"GA_{ref}_{f_name}-ave.fif"
                        evoked.save(out_name, overwrite=True, verbose=False)
                        print(f"  OK: {out_name.name} | N={evoked.nave}")
                    
                    del epochs_list
                    gc.collect()

if __name__ == "__main__":
    crear_averages_estrictos()
