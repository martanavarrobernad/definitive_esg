# -*- coding: utf-8 -*-
# calcula umbrales adpatativos para el rechazo de epocas en base a los diferentesa filtros que aplicamos, es decir,
# 1. Filtra, 2.Calcula umbrales, por lo tanto el rechgazo de epochs sera adaptado a cada filtro
import mne
import numpy as np
from pathlib import Path
import gc
import os

# configuracion d entorno porque estaba crasheando al usar linux
os.environ['QT_QPA_PLATFORM'] = 'xcb'

# configuracion de rutas
BASE_DIR = Path("/home/marta.navarrobernad/Desktop/sub-P02/eeg")
INPUT_DIR = BASE_DIR / "EPOCHS_STAGING"
OUT_DIR = BASE_DIR / "CLEAN_EPOCHS_BENCHMARK"
REPORT_DIR = BASE_DIR / "REPORTS_CLEANING"

OUT_DIR.mkdir(exist_ok=True, parents=True)
REPORT_DIR.mkdir(exist_ok=True, parents=True)

# grupos de canales, los dividimos porque no queremos que el umbral de canales mas ruidosos como axila y erb contaminen los de esg 
# ignoraremos los canales de referencia para no drop epochs por culpa de estos
CH_ESG_BASE = ['Iz', 'SC1', 'SC6', 'S3', 'S4', 'S5', 'S6', 'S7', 'S8', 'S9', 
               'S11', 'S12', 'S13', 'S14', 'S15', 'S16', 'S17', 'S18', 'S19']
CH_ERB = ['ENG_ERB_BIP']
CH_AXI = ['ENG_AXILLA_BIP']
CH_REFS = ['AC', 'TH6']

# definir los filtros, haremos una limpieza por umbral para cada filtro por separado
def get_filter_defs():
    return {
        "Nierula_Std": {"l": 30, "h": 400, "order": 4, "type": "iir"},
        "Nierula_Late": {"l": 5, "h": 400, "order": 4, "type": "iir"},
        "Gabrieli": {"l": 50, "h": 800, "len":'auto', "type": "fir"},
        "Nierula_Otro": {"l": 1, "h": 400, "order": 2, "type": "iir"},
        "Mehra": {"l": 10, "h": 1500, "order": 2, "type": "iir"},
        "Wimmer": {"l": 0.5, "h": 60, "order": 3, "type": "iir_mixed"},
        "Boehme": {"l": 2, "h": 2000, "order": 4, "type": "iir"}
    }

# calcula la amplitud peak to peak por epoica, distancia entre el punto mas alto y mas bajo
# percentil 98, identificamos el valor que deja fuera solo al 2% peor
# grabación muy ruidosa, el limite sube, grabacion muy limpia, limite de 100 microvolts
def get_thr(epochs, ch_type, minimum):
    data = epochs.copy().pick_types(**{ch_type: True}).get_data()
    if data.size == 0: return minimum
    p2ps = (np.max(data, axis=2) - np.min(data, axis=2)).max(axis=1) * 1e6
    return max(np.percentile(p2ps, 98), minimum)

def main():
    files = sorted(list(INPUT_DIR.glob("*-epo.fif")))
    filters = get_filter_defs()
    
    for f_path in files:
        print(f"\n Procesando archivo: {f_path.name}")
        # Cargamos épocas segmentadas (-0.05 a 0.8s) y sin habituación
        epochs_orig = mne.read_epochs(f_path, preload=True, verbose=False)

        for f_name, p in filters.items():
            print(f" Aplicando Filtro: {f_name}")
            report = mne.Report(title=f"Limpieza {f_path.stem} - {f_name}")
            ep_filt = epochs_orig.copy()
            
            # 1. FILTRADO ESPECÍFICO
            if p["type"] == "iir":
                ep_filt.filter(p["l"], p["h"], method='iir', 
                               iir_params=dict(order=p["order"], ftype='butter'), 
                               phase='zero', verbose=False)
            elif p["type"] == "fir":
                ep_filt.filter(p["l"], p["h"], method='fir', phase='zero', 
                               filter_length=p["len"], fir_design='firwin', verbose=False)
            elif p["type"] == "iir_mixed":
                # Lógica específica para Wimmer
                ep_filt.filter(0.5, 60, method='iir', 
                               iir_params=dict(order=3, ftype='butter'), 
                               phase='zero', verbose=False)

            # 2. CONFIGURACIÓN DE CANALES PARA UMBRALES
            # Resetear todo a misc para que no cuente en el rechazo por defecto
            ep_filt.set_channel_types({ch: 'misc' for ch in ep_filt.ch_names}, verbose=False)
            
            # Reactivar tipos según tus listas para el drop_bad, los etiquetamos como eeg emg y eog para que MNE los reconozca como diferentes 
            for ch in CH_ESG_BASE:
                if ch in ep_filt.ch_names: ep_filt.set_channel_types({ch: 'eeg'}, verbose=False)
            if CH_ERB[0] in ep_filt.ch_names: ep_filt.set_channel_types({CH_ERB[0]: 'emg'}, verbose=False)
            if CH_AXI[0] in ep_filt.ch_names: ep_filt.set_channel_types({CH_AXI[0]: 'eog'}, verbose=False)
            # 3. CÁLCULO DE UMBRALES ADAPTATIVOS SOBRE SEÑAL FILTRADA
            #calculamos un umbral diferente para cada uno, los valores 100,250 y 400 son limites de confianza, no limpiar por debajo de ese valor 
            #trial and error + biblografia
            t_esg = get_thr(ep_filt, 'eeg', 100)
            t_erb = get_thr(ep_filt, 'emg', 250)
            t_axi = get_thr(ep_filt, 'eog', 400)

            # 4. RECHAZO (DROP BAD)
            # Ignoramos referencias (CH_REFS) ya que están como 'misc'
            ep_filt.drop_bad(reject={'eeg': t_esg*1e-6, 'emg': t_erb*1e-6, 'eog': t_axi*1e-6}, verbose=False)

            # 5. GUARDAR ÉPOCAS LIMPIAS (Para ver componentes tardíos después)
            out_name = OUT_DIR / f"Clean_Epochs_{f_path.stem}_{f_name}-epo.fif"
            ep_filt.save(out_name, overwrite=True, verbose=False)
            # Añadimos las épocas al reporte (las estadísticas se generan solas)
            report.add_epochs(epochs=ep_filt, title=f'Resultados {f_name}')
            report_path = REPORT_DIR / f"Report_{f_path.stem}_{f_name}.html"
            report.save(report_path, overwrite=True, open_browser=False, verbose=False)
            
            print(f"      Filtro {f_name}: {len(ep_filt)} épocas restantes. Thr ESG: {t_esg:.1f}µV")

            del ep_filt, report; gc.collect()
        del epochs_orig; gc.collect()

    print("\n limpieza completada")

if __name__ == "__main__":
    main()
